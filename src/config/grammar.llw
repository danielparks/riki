token
  LBrace='{' RBrace='}' LParen='(' RParen=')' Comma=',' Equal='='
  Identifier='<identifier>'
  BareGlob='<bare glob>'
  Path='<path>'
  QuotedDouble='<"string">'
  QuotedSingle='<\'string\'>'
  Newline='\\n';

start file;

file: context;
context^: (?1 Newline+ line)* Newline*
  | line (?1 Newline+ line)* Newline*;
line: ?1 Identifier set @set
  | ?2 Identifier params @function
  | matcher @action [
    block @context
    | value @rule
  ];
set^: '=' value;
// FIXME allow Newline within function parameters
params^: '(' [value (',' value)*] ')';
block^: '{' context '}';
matcher: Identifier | Path | BareGlob | QuotedDouble | QuotedSingle;
// This means that function calls are not within the value rule; the value rule
// only ever contains a string.
value: Identifier [ params @function ] | Path | QuotedDouble | QuotedSingle;

/*
A line can have:

token = ... // var = value
token ( ... // id ( possibly more spaces )
token { // glob {
token token ( ... // glob id ( possibly more spaces )
token token // glob action
token // action
*/

